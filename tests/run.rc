#!/bin/rc
rfork E

script=$0
switch($script){
case /*
	;
case *
	script=`{pwd}^/^$script
}
testroot=`{basename -d $script}
root=`{basename -d $testroot}
bin=$root/nervous

if(! test -x $bin){
	echo $0: working-tree nervous executable missing >[1=2]
	echo $0: build with '''mk tests''' >[1=2]
	exit no-binary
}

rc $testroot/frontend/run.rc $bin || exit frontend
rc $testroot/bytecode/run.rc $bin || exit bytecode
rc $testroot/vm/run.rc $bin || exit vm
rc $testroot/pattern/run.rc || exit pattern
rc $testroot/process/run.rc || exit process
rc $testroot/memory/run.rc || exit memory

out=`{$bin -r $root/examples/arithmetic.nv main} || exit source-run
if(! ~ $out 51){
	echo FAIL: source arithmetic returned $out >[1=2]
	exit source-run
}
out=`{$bin -r $root/examples/pingpong.nv main} || exit source-run
if(! ~ $out 42){
	echo FAIL: source pingpong returned $out >[1=2]
	exit source-run
}
out=`{$bin -r $root/examples/rpc.nv main} || exit source-run
if(! ~ $out 42){
	echo FAIL: source RPC returned $out >[1=2]
	exit source-run
}
echo ok - scheduler-backed source execution and Ref-correlated RPC

# sieve.nv recurses once per candidate in generate and once per message in
# each filter; both are tail calls, so it must run in constant frame depth
# rather than faulting system_limit at maxframe. The limit is passed as the
# root argument so the example's own default can change freely: 172 primes
# below 1024, plus the root's final 'ok, is 173 lines.
out=`{$bin -r $root/examples/sieve.nv main 1023 | wc -l} || exit source-run
if(! ~ $out 173){
	echo FAIL: source sieve printed $out lines, expected 173 >[1=2]
	exit source-run
}
echo ok - tail-recursive sieve runs in constant frame depth

# ring.nv: 10 nodes, 2000 laps, every node a tail-recursive receive loop
# handling 2000 messages in one frame. Root value is the hop count.
out=`{$bin -r $root/examples/ring.nv main} || exit source-run
if(! ~ $out 20000){
	echo FAIL: source ring returned $out, expected 20000 >[1=2]
	exit source-run
}
echo ok - token ring message passing

tmp=/tmp/nervous-cli-$pid
mkdir $tmp || exit mkdir
# orphan: the root faults with a child still blocked; the root fault must be
# reported first and the idle scheduler second, not masked as plain deadlock.
for(name in fault exit deadlock orphan){
	$bin -r $testroot/process/cli/$name.nv main >$tmp/$name.out >[2]$tmp/$name.err
	if(~ $status ''){
		echo FAIL: CLI $name expected failure >[1=2]
		rm -rf $tmp
		exit source-run
	}
	if(test -s $tmp/$name.out || ! cmp -s $testroot/process/cli/$name.err $tmp/$name.err){
		echo FAIL: CLI $name diagnostic mismatch >[1=2]
		rm -rf $tmp
		exit source-run
	}
}
echo ok - source CLI fault, exit, and deadlock diagnostics

# D053-D057: print/eprint visibly write during execution, render every term
# kind exactly as nvvalueprint already does, and are ordered by dispatch
# order across processes. Each check compares whole stdout byte-for-byte.
# hello.nv is the milestone 07 exit-criterion example (README/milestones/
# 07-io.md); its source lives under examples/, its golden output under
# tests/process/cli/ alongside the other io fixtures' source and goldens.
# isolation.nv (a child faults; siblings and root continue; the lost reply
# is detected by `after`) and ioserver.nv (I/O as a Ref-correlated message
# exchange with a device process) are examples too, with goldens here.
for(name in hello print-kinds print-order isolation ioserver){
	src=$testroot/process/cli/$name.nv
	if(~ $name hello isolation ioserver)
		src=$root/examples/$name.nv
	$bin -r $src main >$tmp/$name.out >[2]$tmp/$name.err
	if(! ~ $status ''){
		echo FAIL: CLI $name expected success >[1=2]
		cat $tmp/$name.err >[1=2]
		rm -rf $tmp
		exit source-run
	}
	if(! cmp -s $testroot/process/cli/$name.out $tmp/$name.out){
		echo FAIL: CLI $name stdout differs >[1=2]
		echo expected: >[1=2]
		cat $testroot/process/cli/$name.out >[1=2]
		echo actual: >[1=2]
		cat $tmp/$name.out >[1=2]
		rm -rf $tmp
		exit source-run
	}
	if(test -s $tmp/$name.err){
		echo FAIL: CLI $name unexpected diagnostic >[1=2]
		cat $tmp/$name.err >[1=2]
		rm -rf $tmp
		exit source-run
	}
}
echo ok - print/eprint visible output, term-kind rendering, and dispatch-order guarantee

# eprint-ok.nv cannot ride the loop above: it deliberately writes to
# stderr, which that loop asserts is empty. Check both streams here.
$bin -r $testroot/process/cli/eprint-ok.nv main >$tmp/eprint-ok.out >[2]$tmp/eprint-ok.err
if(! ~ $status ''){
	echo FAIL: CLI eprint-ok expected success >[1=2]
	cat $tmp/eprint-ok.err >[1=2]
	rm -rf $tmp
	exit source-run
}
if(! cmp -s $testroot/process/cli/eprint-ok.out $tmp/eprint-ok.out || ! cmp -s $testroot/process/cli/eprint-ok.err $tmp/eprint-ok.err){
	echo FAIL: CLI eprint-ok stdout or stderr differs >[1=2]
	echo expected stdout: >[1=2]
	cat $testroot/process/cli/eprint-ok.out >[1=2]
	echo actual stdout: >[1=2]
	cat $tmp/eprint-ok.out >[1=2]
	echo expected stderr: >[1=2]
	cat $testroot/process/cli/eprint-ok.err >[1=2]
	echo actual stderr: >[1=2]
	cat $tmp/eprint-ok.err >[1=2]
	rm -rf $tmp
	exit source-run
}
echo ok - eprint writes to stderr while stdout carries only the root report

# D056: a host write failure faults the writing process with io_error. Fd 1
# is closed before exec so the print inside io-error.nv's root process hits
# a real write failure on its explicit per-call flush, deterministically,
# without touching a pipe (no 9front "write on closed pipe" note involved).
$bin -r $testroot/process/cli/io-error.nv main >[1=] >[2]$tmp/io-error.err
if(~ $status ''){
	echo FAIL: CLI io-error expected failure >[1=2]
	rm -rf $tmp
	exit source-run
}
if(! cmp -s $testroot/process/cli/io-error.err $tmp/io-error.err){
	echo FAIL: CLI io-error diagnostic mismatch >[1=2]
	cat $tmp/io-error.err >[1=2]
	rm -rf $tmp
	exit source-run
}
echo ok - source CLI io_error fault on a closed host output stream

rm -rf $tmp

echo all nervous regression suites passed
exit ''

// M09 T02/T03 smoke: binary construction and matching, end to end.
fn frame(payload, n) {
	<<n:8, payload/binary>>
}

fn unframe(<<n:8, p:n/binary, rest/binary>>) {
	${p, rest}
}

fn kind(<<1:8, v:16/little>>) {
	${'one, v}
}

fn kind(<<2:8, v:32/signed>>) {
	${'two, v}
}

fn kind(b) when is_binary(b) {
	'other
}

fn kind(_) {
	'notbinary
}

fn main() {
	hi = <<104:8, 105:8>>;
	msg = <<hi/binary, 33:8>>;
	f = frame(msg, 3);
	${p, rest} = unframe(<<f/binary, 7:8, 8:8>>);
	<<a:16, b:16/little, c:8/signed, d:16/signed/little>> = <<1:8, 2:8, 1:8, 2:8, 255:8, 254:8, 255:8>>;
	r = match <<5:8, 6:8>> {
		<<q:8, 7:8>> => ${'bad, q};
		<<q:8, t/binary>> => ${'good, q, t};
	};
	${p, rest, a, b, c, d, <<msg:2/binary>>, <<-1:16/signed/little, 258:16>>, kind(<<1:8, 2:8, 1:8>>), kind(<<2:8, -5:32/signed>>), kind(<<9:8>>), kind(42), r, <<>>}
}

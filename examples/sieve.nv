// Concurrent sieve of Eratosthenes.
//
// generate/3 feeds candidate numbers 2..limit into a chain of filter
// processes. The chain starts empty (next == 'nil). Whenever a number
// reaches the end of the chain undivided by any earlier prime, it is
// itself prime: print it and spawn one more filter process to hold it.
// A 'done message drains down the whole chain and each filter exits.
//
// No lists exist yet in this language, so the "sieve" is built entirely out
// of processes and messages rather than out of data.
//
// generate recurses once per candidate and each filter once per message it
// receives; both calls are in tail position, so they run in constant frame
// depth and the limit is bounded by the mailbox budget, not by maxframe.
//
// filter's three cases for a candidate -- divisible, end of chain, forward
// -- are receive clauses with `when` guards (D060) rather than an if chain
// inside one clause; the guards run on the tentative bindings before the
// message is taken.

fn generate(n, limit, next) {
	if n > limit {
		if next != 'nil {
			next ! ${'done}
		}
		'ok
	} else if next == 'nil {
		nf = spawn filter(n, 'nil);
		print(n);
		generate(n + 1, limit, nf)
	} else {
		next ! ${'num, n};
		generate(n + 1, limit, next)
	}
}

fn filter(p, next) {
	receive {
		${'num, n} when n % p == 0 => filter(p, next);
		${'num, n} when next == 'nil => {
			nf = spawn filter(n, 'nil);
			print(n);
			filter(p, nf)
		}
		${'num, n} => {
			next ! ${'num, n};
			filter(p, next)
		}
		${'done} => {
			if next != 'nil {
				next ! ${'done}
			}
			exit 'ok
		}
	}
}

// `nervous -r sieve.nv main` sieves to 10000 (1229 primes); `main 1023`
// or any other integer argument sets the limit instead.
fn main() {
	generate(2, 10000, 'nil)
}

fn main(limit) {
	generate(2, limit, 'nil)
}
